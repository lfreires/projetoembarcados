# Copie para ".env" e preencha. O .env NAO vai para o GitHub.

# ---------- login do painel ----------
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=troque-esta-senha
ADMIN_PIN=1234
SECRET_KEY=troque-por-um-texto-grande-e-aleatorio

# ---------- modo de operacao ----------
# 1 = central simulada dentro do backend (nao precisa de placa nem de Azure)
# 0 = central de verdade, pelo Azure IoT Hub
SIMULADOR=1

# ---------- Azure IoT Hub (plano F1, gratuito) ----------
# Portal > IoT Hub > Security settings > Shared access policies > service > Primary connection string
IOTHUB_SERVICE_CONN=
# Portal > IoT Hub > Hub settings > Built-in endpoints > Event Hub-compatible endpoint
IOTHUB_EVENTHUB_CONN=
DEVICE_ID=central01

# ---------- alertas ----------
# E-mail (Gmail: criar uma "senha de app" em myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_SENHA=
# Telegram (opcional): token do bot criado no @BotFather
TELEGRAM_TOKEN=

# ---------- agente ----------
# Ollama rodando no PC do grupo. Vazio = agente por regras (sem LLM).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.2

# ---------- nomes das zonas (aparecem no painel e nos alertas) ----------
ZONA1=Ambiente 1 (janela + ultrassom)
ZONA2=Ambiente 2 (PIR + ultrassom)
ZONA3=Ambiente 3 (PIR + ultrassom)
ZONA4=Quintal (cerca IR + portinhola)
